# Backend base URL used in DEVELOPMENT only (in production the client talks
# to the same-origin /api/backend proxy — see next.config.mjs rewrites).
# Use 127.0.0.1, not localhost: Spotify's redirect URI must be a loopback IP
# and session cookies are host-scoped, so open the app at
# http://127.0.0.1:3000 in dev.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3002

# Optional: server-side rewrite target for the /api/backend proxy in
# production (private networking). Falls back to NEXT_PUBLIC_BACKEND_URL.
# TODO(owner): set to the deployed backend URL, e.g. https://api.example.com
# BACKEND_INTERNAL_URL=

# Active client payment provider: "stripe" | "razorpay" (defaults to stripe)
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
